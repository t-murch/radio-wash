# RadioWash Environment Variables
#
# This file covers two consumers:
#   - the Next.js frontend  -> copy the NEXT_PUBLIC_* / API_BASE_URL block to web/.env.local
#   - the API container     -> copy the "API container" block below to .env at the repo root
#     (docker-compose.yml reads .env; the API itself is configured from these).

# ===================
# API container (docker-compose.yml)
# ===================
#
# Why these exist: api/.dockerignore excludes appsettings.*.json so developer secrets are never
# baked into an image. That means a containerised API cannot see appsettings.Development.json —
# the only config inside the container is appsettings.json, which points at the deployed
# Supabase project. Without the values below, tokens are validated against the wrong issuer
# (blanket 401s) and the browser origin is rejected by CORS. The API refuses to start in
# Development if they are missing, rather than failing mysteriously at request time.
#
# Get the secret and ports from `supabase status`.

# Local Supabase JWT signing secret ("JWT secret" in `supabase status`). GoTrue signs local
# tokens with HS256 using this value, so the API must hold the identical string.
SUPABASE_JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long

# Anon / service-role keys from `supabase status`.
SUPABASE_ANON_KEY=your_local_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_local_service_role_key

# Ports from `supabase status`. The defaults below match a stock `supabase start`; override
# them only if you shifted ports in supabase/config.toml (e.g. to run two projects at once).
SUPABASE_API_PORT=54321
SUPABASE_DB_PORT=54322

# Container name of the local Supabase gateway, used for container-to-container JWKS calls.
# Follows the pattern supabase_kong_<project-id> from supabase/config.toml.
SUPABASE_KONG_HOST=supabase_kong_RadioWash

# The single origin CORS admits. Must match the URL you open in the browser exactly,
# including scheme and port — http://localhost:3000 and https://127.0.0.1:3000 are distinct.
FRONTEND_URL=https://127.0.0.1:3000

# Stripe TEST-mode credentials (dashboard.stripe.com, toggled to test mode). Required for
# checkout locally: docker-compose.yml injects these into the API container. Without them the
# container would fall back to the appsettings.json baked into the image — which holds
# LIVE-mode keys — so compose injects empty strings instead, making Stripe calls fail loudly
# rather than touch live billing. The price must exist in TEST mode and match the seeded
# Sync Plan ($5.00/month).
STRIPE_SECRET_KEY=sk_test_your_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_key
STRIPE_WEBHOOK_SECRET=whsec_from_stripe_listen
STRIPE_PRICE_PLAN_ID=price_your_test_mode_price

# Apple Music (optional — the API boots without it and Apple endpoints return 503 until set).
# TeamId and KeyId come from the Apple Developer portal; the base64 value is your MusicKit
# .p8 private key: `base64 -w0 AuthKey_XXXXXXXXXX.p8`. Keep the .p8 itself outside the repo.
APPLE_MUSIC_TEAM_ID=your_apple_team_id
APPLE_MUSIC_KEY_ID=your_apple_key_id
APPLE_MUSIC_PRIVATE_KEY_B64=your_base64_encoded_p8_key

# ===================
# Next.js Configuration
# ===================

# API Configuration
NEXT_PUBLIC_API_URL=http://127.0.0.1:5159
NEXT_PUBLIC_WEB_URL=http://localhost:3000
API_BASE_URL=http://127.0.0.1:5159/api

# ===================
# Supabase Configuration
# ===================

NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# ===================
# Stripe Configuration
# ===================

NEXT_PUBLIC_STRIPE_PRICE_ID_MONTHLY=your_stripe_price_id

# ===================
# Analytics Configuration
# ===================

# Enable/disable Plausible Analytics (set to "true" to enable)
NEXT_PUBLIC_ENABLE_ANALYTICS=false

# Your domain name for Plausible Analytics tracking
# Example: radiowash.com
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=your_domain.com

# ===================
# Sentry Configuration
# ===================

# Build-time only: used by @sentry/nextjs to upload source maps during `pnpm build`.
# Must NOT be prefixed with NEXT_PUBLIC_ (that would inline the token into the client bundle).
SENTRY_AUTH_TOKEN=your_sentry_auth_token

# Public DSN (safe to ship in the client bundle).
NEXT_PUBLIC_SENTRY_DSN=your_sentry_dsn

# Server-side DSN (used by sentry.server.config.js in the Node.js runtime).
SENTRY_DSN=your_sentry_dsn

# ===================
# Development Notes
# ===================
#
# 1. Never commit actual .env files with secrets to version control
# 2. Keep .env.local and .env in .gitignore
# 3. Update this .env.example file when adding new environment variables
# 4. For production, set these variables in your hosting platform's environment settings
